# SprinklerFun — environment configuration
# Copy to `.env.local` and fill in. All values are server-side unless prefixed
# NEXT_PUBLIC_.

# --- Turso / libSQL -------------------------------------------------------
# The libSQL database URL. Leave BOTH of these unset for local development —
# the app falls back to a local SQLite file at ./.data/sprinkler.db (gitignored).
# For production, point at your Turso database:
#   TURSO_DATABASE_URL=libsql://<your-db>.turso.io
TURSO_DATABASE_URL=

# Auth token for the remote Turso database (not needed for file: URLs).
TURSO_AUTH_TOKEN=

# --- App password (the only credential) -----------------------------------
# Set this and every page and API route requires a session cookie, obtained by
# logging in with this password (see proxy.ts). The password is server-side
# only: the browser receives an httpOnly cookie holding an HMAC of it, never the
# value. Nothing here is NEXT_PUBLIC_, and nothing here should be — the variable
# this replaced was, which is precisely why it protected nothing.
#
# Leave it UNSET locally: the app is open, which is what `npm run dev` and both
# test suites expect. Leaving it unset on a DEPLOYMENT is fatal by design — every
# request is refused with a 503 rather than served to whoever finds the URL.
#
# Rotating it logs every device out, because the cookie is derived from it. Use
# something long and random from a password manager.
APP_PASSWORD=
