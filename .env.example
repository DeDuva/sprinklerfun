# SprinklerFun — environment configuration
# Copy to `.env.local` and fill in. All values are server-side unless prefixed
# NEXT_PUBLIC_.

# --- Turso / libSQL -------------------------------------------------------
# The libSQL database URL. Leave BOTH of these unset for local development —
# the app falls back to a local SQLite file at ./.data/sprinkler.db (gitignored).
# For production, point at your Turso database:
#   TURSO_DATABASE_URL=libsql://<your-db>.turso.io
TURSO_DATABASE_URL=

# Auth token for the remote Turso database (not needed for file: URLs).
TURSO_AUTH_TOKEN=

# --- Google sign-in (the only credential) ---------------------------------
# Set all three and every page and API route requires a Google session (see
# proxy.ts). Leave them UNSET locally: the app runs open, which is what
# `npm run dev` and both test suites expect — a headless browser cannot drive a
# Google consent screen. Leaving them unset on a DEPLOYMENT is fatal by design:
# every request is refused with a 503 rather than served to whoever finds the URL.
#
# From the Google Cloud console, OAuth 2.0 Client ID of type "Web application".
# The authorised redirect URI must be exactly:
#   https://<your-domain>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Any long random value: `openssl rand -base64 32`.
# Changing it invalidates every existing session, which is the log-everyone-out
# lever. Nothing here is NEXT_PUBLIC_ and nothing here should be.
SESSION_SECRET=

# --- Who is allowed in ----------------------------------------------------
# Comma-separated list of Google addresses permitted to sign in. Anyone else is
# refused after authenticating, however valid their Google account.
#
# An EMPTY list denies everyone, deliberately: "no list, so allow all" would
# hand the database to any Google account the moment this variable went missing.
#
# It lives here rather than in a committed file because this repository is
# public, and a checked-in list of household addresses is published permanently,
# including in git history.
#
# It is re-read on every request, so removing an address revokes that person on
# their next click rather than whenever their cookie happens to expire.
#   ALLOWED_EMAILS=someone@gmail.com,someone.else@gmail.com
ALLOWED_EMAILS=

# --- Flume API (optional: automatic data sync) -----------------------------
# Set all four and the app pulls meter data from Flume on a daily schedule
# instead of waiting for a CSV upload. Leave them unset and nothing changes —
# the manual uploader still works, and /api/sync reports 503.
#
# Credentials come from Flume: request Personal API access in the Flume app
# (Settings → API access), which gives a client id and secret. The username and
# password are your ordinary Flume account login.
#
# There are no stored tokens: each sync does the OAuth2 password grant fresh.
# That costs one request against a 120/hour limit and removes the need for a
# credentials table, at-rest encryption and a connect/disconnect UI.
FLUME_CLIENT_ID=
FLUME_CLIENT_SECRET=
FLUME_USERNAME=
FLUME_PASSWORD=

# Optional. Which water sensor to read, when the account has more than one.
# Unset means "the first Water Sensor on the account", which is right for a
# single-meter household.
FLUME_DEVICE_ID=

# --- Cron ------------------------------------------------------------------
# Authenticates the daily sync. Vercel sends this as `Authorization: Bearer
# <CRON_SECRET>` when it invokes /api/cron, which is excluded from the session
# guard because a cron request carries no session.
#
# Unset means /api/cron refuses everything. That is deliberate: the alternative
# leaves a public endpoint that triggers a full ingest and a whole-table
# recompute on demand. Use a long random value: `openssl rand -base64 32`.
CRON_SECRET=
